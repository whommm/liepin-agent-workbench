{
  "_comment_api": "【API 配置】敏感信息建议写入 .env 文件，此文件只保留非敏感项",
  "api_base_url": "",
  "api_key": "",
  "api_key_env": "LIEPIN_AGENT_API_KEY",
  "model_name": "",

  "_comment_backend": "【后端 LLM 配置】匹配候选人用的 LLM，留空则 fallback 到上方默认配置",
  "backend_api_base_url": "",
  "backend_api_key": "",
  "backend_model_name": "",

  "_comment_tavily": "【搜索增强】Tavily 搜索引擎 API Key（可选）",
  "tavily_api_key": "",

  "_comment_llm": "【LLM 调用参数】控制模型输出行为和重试策略",
  "timeout": 120,
  "llm_max_retries": 2,
  "llm_max_tokens": 4096,
  "llm_temperature": 0.2,
  "llm_provider": "openai",
  "backend_llm_provider": "openai",

  "_comment_browser": "【浏览器配置】控制 Playwright 浏览器行为",
  "theme": "light",
  "liepin_browser_channel": "msedge",
  "liepin_browser_headless": false,
  "liepin_browser_profile_dir": "browser_profile/liepin",

  "_comment_greeting": "【打招呼配置】控制批量打招呼和话术生成",
  "greeting_template": "",
  "auto_greeting_enabled": false,
  "greet_gold_only": false,

  "_comment_runtime": "【Agent 运行时参数】控制寻访任务的并发和停止条件",
  "match_queue_workers": 3,
  "match_concurrency_limit": 10,
  "max_rounds_default": 10,
  "max_detail_fetches_default": 999,
  "target_ab_count_default": 999,
  "consecutive_low_yield_threshold": 2,
  "jd_truncate_length": 800,

  "_comment_fetch": "【详情抓取策略】不同轮次类型的抓取上限和等待策略",
  "sample_detail_limit": 10,
  "validate_detail_limit": 20,
  "harvest_detail_limit": 40,
  "sample_detail_min_results": 3,
  "validate_detail_min_results": 8,
  "match_wait_timeout_seconds": 300,

  "_comment_debug": "【调试】是否保存浏览器页面快照用于排错",
  "debug_snapshots_enabled": false
}
